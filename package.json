{
  "name": "bookmark-pro",
  "description": "强大的书签管理器 - 侧栏树形视图、拖拽排序、全局搜索、快速收藏",
  "private": true,
  "version": "1.11.11",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "bun run icons:build && bun run typecheck && wxt build",
    "icons:build": "bun scripts/build-icon.ts",
    "reload": "reload-extension \"Bookmark Pro\"",
    "build:reload": "bun run build && bun run reload",
    "zip": "wxt zip",
    "typecheck": "bun check",
    "postinstall": "wxt prepare",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.21.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.36",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "reload-extension": "^0.4.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
